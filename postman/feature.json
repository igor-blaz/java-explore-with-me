		{
			"name": "Опубликовать комментарий. СОбытие не сущетсвует (Должжно быть 404)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"function http(o){\r",
							"  return new Promise((res, rej) =>\r",
							"    pm.sendRequest(o, (e, r) => e ? rej(e) : res(r))\r",
							"  );\r",
							"}\r",
							"\r",
							"async function ensureUser() {\r",
							"  let userId = pm.environment.get(\"userId\");\r",
							"  if (userId) return Number(userId);\r",
							"\r",
							"  // создаём пользователя (без поля userId в теле)\r",
							"  const r = await http({\r",
							"    url: \"http://localhost:8080/admin/users\",\r",
							"    method: \"POST\",\r",
							"    header: { \"Content-Type\": \"application/json\" },\r",
							"    body: {\r",
							"      mode: \"raw\",\r",
							"      raw: JSON.stringify({\r",
							"        email: `test+${Date.now()}@example.com`,\r",
							"        name: \"PreRequest User\"\r",
							"      })\r",
							"    }\r",
							"  });\r",
							"\r",
							"  const user = r.json();\r",
							"  pm.environment.set(\"userId\", String(user.id));\r",
							"  return Number(user.id);\r",
							"}\r",
							"\r",
							"(async () => {\r",
							"  const userId = await ensureUser();\r",
							"\r",
							"  // Делаем userId доступным и как переменную запроса\r",
							"  pm.variables.set(\"userId\", userId);\r",
							"\r",
							"  \r",
							"  pm.request.body.update({\r",
							"    mode: \"raw\",\r",
							"    raw: JSON.stringify({\r",
							"      userId: userId,\r",
							"      text: \"Комментарий из pre-request\"\r",
							"    }),\r",
							"    options: { raw: { language: \"json\" } }\r",
							"  });\r",
							"})();\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Endpoint is alive (no 5xx)\", () => {\r",
							"  pm.expect(pm.response.code, `status=${pm.response.code}`).to.be.below(500);\r",
							"});\r",
							"pm.test(\"Latency < 2s\", () => {\r",
							"  pm.expect(pm.response.responseTime).to.be.below(2000);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
